{
  "_comment": "Search criteria. The resume itself is NOT stored here (see resume/README.md). Regexes are case-insensitive.",
  "targetRoles": [
    "Director of Editorial",
    "Editorial Director",
    "Head of Editorial",
    "Director of Content Strategy",
    "VP of Content Strategy",
    "Head of Content",
    "Content Director",
    "Executive Editor",
    "Editor-in-Chief",
    "Director of Audience Development",
    "Head of SEO / Director of SEO",
    "Director of Content Marketing",
    "Head of Editorial at a tech company (robotics, AI, consumer tech)"
  ],
  "titleRules": {
    "seniority": "\\b(director|head of|head,|vp|vice president|chief|executive editor|editor[- ]in[- ]chief|editorial lead|managing director|global head)\\b",
    "domain": "\\b(editorial|editor|content|storytelling|narrative|publishing|newsroom|journalism|newsletters?|audience|seo|search engine|organic (growth|search|traffic)|brand voice|creative strategy)\\b",
    "exclude": "\\b(intern|internship|engineer|engineering|software|data scien|account executive|sales|security|legal counsel|recruit|finance|accounting|warehouse|nurse|physician|clinical|paid (search|media|social)|trust (and|&) safety|content moderation)\\b"
  },
  "salary": {
    "minAnnualUSD": 160000,
    "_rule": "Jobs whose posted MAX pay is below the minimum are dropped. Jobs with no posted pay are kept and flagged so Claude can judge them."
  },
  "location": {
    "remoteOK": true,
    "remoteRegions": [
      "united states",
      "usa",
      "us",
      "north america",
      "americas",
      "anywhere",
      "worldwide",
      "global",
      "remote"
    ],
    "cities": [
      "Denver",
      "Boulder",
      "Colorado"
    ],
    "_note": "Ben is in Denver. Remote US roles plus on-site/hybrid in these places are kept; other on-site roles are dropped."
  },
  "searchQueries": [
    "editorial director",
    "content strategy director",
    "head of content",
    "director of content",
    "executive editor",
    "head of editorial",
    "director audience development",
    "director of seo",
    "vp content"
  ],
  "jobicyTags": [
    "content",
    "editorial",
    "editor",
    "seo"
  ],
  "scoring": {
    "enabled": true,
    "model": "claude-opus-5-5",
    "maxNewScoresPerRun": 40,
    "coverLetterMinScore": 75,
    "maxCoverLettersPerRun": 8
  },
  "retentionDays": 45
}
